{
    "name":  "fast-hands-mcp",
    "version":  "0.6.1",
    "type":  "module",
    "description":  "Local-first Windows execution layer for AI agents with persistent PowerShell, durable checkpoints, live operator control, Windows UI, web research and YouTube research integrations.",
    "main":  "server.mjs",
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "start":  "node server.mjs --http",
                    "stdio":  "node server.mjs",
                    "monitor":  "node monitor-server.mjs",
                    "check":  "node --check server.mjs \u0026\u0026 node --check monitor-server.mjs \u0026\u0026 node --check windows-ui-bridge.mjs",
                    "test":  "node scripts/self-test.mjs \u0026\u0026 node --test test/*.test.mjs",
                    "pack:check":  "npm pack --dry-run",
                    "audit:repo":  "node scripts/repo-audit.mjs"
                },
    "dependencies":  {
                         "@modelcontextprotocol/client":  "2.0.0",
                         "@modelcontextprotocol/node":  "2.0.0",
                         "@modelcontextprotocol/server":  "2.0.0",
                         "zod":  "^4.1.5"
                     },
    "files":  [
                  "server.mjs",
                  "monitor-server.mjs",
                  "powershell-host.ps1",
                  "windows-ui-bridge.mjs",
                  "monitor.html",
                  "start-server.cmd",
                  "start-monitor.cmd",
                  "macros/inspect_window.json",
                  "integrations/fastweb/fast_web.py",
                  "integrations/youtube/research.py",
                  "integrations/youtube/transcript_helper.py",
                  "scripts/setup-research.ps1",
                  "docs/ARCHITECTURE.md",
                  "docs/TOOLS.md",
                  "requirements-research.txt",
                  "README.md",
                  "SECURITY.md",
                  "PRIVACY.md",
                  "SCOPE.md",
                  "SUPPORT.md",
                  "THREAT_MODEL.md",
                  "THIRD_PARTY.md",
                  "CHANGELOG.md"
              ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/tomaszteee/FastHands.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/tomaszteee/FastHands/issues"
             },
    "homepage":  "https://github.com/tomaszteee/FastHands#readme",
    "keywords":  [
                     "ai-agent",
                     "automation",
                     "windows",
                     "mcp",
                     "mcp-server",
                     "computer-use",
                     "powershell",
                     "human-in-the-loop",
                     "checkpoint",
                     "desktop-automation",
                     "web-research",
                     "youtube-research"
                 ],
    "os":  [
               "win32"
           ]
}
